# Absolute path to the directory containing one subfolder per project.
LIBRARY_ROOT=/path/to/library

# Absolute path to the directory where the SQLite database file is stored.
DATABASE_PATH=/path/to/data/model-hub.sqlite3

# HTTP port the API listens on.
PORT=4000

# How often (ms) the full-library reconciliation backstop scan runs.
LIBRARY_SCAN_INTERVAL_MS=60000

# Quiet period (ms) after a filesystem event before a project is reconciled.
SYNC_DEBOUNCE_MS=5000

# Whether to run a live chokidar watcher in addition to the periodic scan.
LIBRARY_WATCH_ENABLED=true

# Set to true for network mounts (NFS/SMB) where inotify events are unreliable.
LIBRARY_WATCH_USE_POLLING=false

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Base URL the thumbnail renderer navigates a headless browser to. Defaults
# to this server's own origin (correct once it serves the built SPA). In
# dev, where the Vite dev server runs separately, point this at it instead:
# WEB_BASE_URL=http://localhost:5173

# How many thumbnails can render concurrently (each is a Chromium page).
THUMBNAIL_CONCURRENCY=1

# OIDC login (Authelia, Authentik, Keycloak, etc.). Leave all of these unset
# for single-user mode: no login screen, every request is a synthetic local
# owner. If you set any one of the three below, all three are required, plus
# SESSION_SECRET.
# OIDC_ISSUER_URL=https://auth.example.com
# OIDC_CLIENT_ID=model-hub
# OIDC_CLIENT_SECRET=changeme
# Defaults to `${WEB_BASE_URL}/auth/callback` — override if that's wrong
# (e.g. reverse-proxied under a different public URL than WEB_BASE_URL).
# OIDC_REDIRECT_URL=https://model-hub.example.com/auth/callback

# Required (32+ chars) when OIDC_* is set; signs the session cookie. Generate
# with e.g. `openssl rand -base64 32`.
# SESSION_SECRET=
